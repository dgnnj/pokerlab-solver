{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PokerLab",
  "version": "0.4.0",
  "identifier": "dev.pokerlab.trainer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PokerLab — Treinador de cash game",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "PokerLab",
    "copyright": "PokerLab contributors — AGPL-3.0-or-later",
    "category": "Education",
    "shortDescription": "Treinador offline de poker cash game (NLHE)",
    "longDescription": "Treino de decisões pós-flop com soluções pré-calculadas pelo postflop-solver, revisão de erros e histórico local.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/packs/": "resources/packs/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEOUUzNkQ1NUM3MjAyNjQKUldSa0FuSmMxVGFlbmVLNEJQMVJVd1AzTDZRckw3T1A2Y0F1a2tlYXBxWDlLdWh2Q3d5TUFkd08K",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
